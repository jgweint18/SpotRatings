<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="Controller">
    <top>
        <HBox spacing="10" style="-fx-padding: 10;">
            <TextField fx:id="searchField" prefWidth="300" promptText="Search for a song..." />
            <Button onAction="#saveRatings" text="Save Ratings" />
            <Button onAction="#loadPlaylist" text="Load File" />
            <Button onAction="#addSong" text="Add Songs" />
        </HBox>
    </top>
    <center>
        <TableView fx:id="songTable">
            <columns>
                <TableColumn fx:id="artworkCol" text="Cover" prefWidth="60"/>
                <TableColumn fx:id="artistCol" prefWidth="200" text="Artist" />
                <TableColumn fx:id="songCol" prefWidth="300" text="Song" />
                <TableColumn fx:id="ratingCol" prefWidth="100" text="Rating" />
            </columns>
        </TableView>
    </center>
</BorderPane>
